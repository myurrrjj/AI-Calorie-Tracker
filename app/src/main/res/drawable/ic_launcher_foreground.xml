<?xml version="1.0" encoding="utf-8"?>
<!-- TrackABite launcher icon — foreground (the leaf mark).
     Drop this in app/src/main/res/drawable/ic_launcher_foreground.xml -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- leaf body: two curves meeting at the tips (26,82) and (82,26) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M26,82 C26,54 54,26 82,26 C82,54 54,82 26,82 Z" />

    <!-- central vein, drawn in the background colour so it reads as a cut-out -->
    <path
        android:strokeColor="#FF0F9D58"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:pathData="M29.5,78.5 L78.5,29.5" />
</vector>
